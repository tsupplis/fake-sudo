#!/bin/sh
# Run the isolated regression suite. Never invoke real doas or remote hosts.
set -eu

case "${1:-}" in
    -h|--help)
        cat <<'HELP'
Usage: sudo_test [unittest-discover options]

Runs tests/ with Python 3; returns nonzero on test failures or runner errors.
Examples:
  ./sudo_test
  ./sudo_test -q
  ./sudo_test -k identity
  FAKE_SUDO_TEST_SHELL=/bin/dash ./sudo_test

PYTHON selects the Python 3 executable (default: python3).
The old SSH smoke-test mode has been removed. To test another host, copy the
checkout (including tests/) there and run ./sudo_test on that host.
All backend calls are stubbed; no root privileges or real doas are needed.
HELP
        exit 0
        ;;
esac

PYTHON=${PYTHON:-python3}
if ! command -v "$PYTHON" >/dev/null 2>&1; then
    printf 'sudo_test: Python 3 executable not found: %s\n' "$PYTHON" >&2
    exit 127
fi
SCRIPT_DIR=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
if [ ! -f "$SCRIPT_DIR/tests/test_wrapper.py" ]; then
    printf '%s\n' 'sudo_test: missing tests/test_wrapper.py; use a complete checkout' >&2
    exit 1
fi
if [ "$#" -eq 0 ]; then
    set -- -v
fi
exec "$PYTHON" -m unittest discover -s "$SCRIPT_DIR/tests" "$@"
